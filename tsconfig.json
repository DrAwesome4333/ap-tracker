{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "plugins": [{ "name": "typescript-plugin-css-modules" }],
        "incremental": true,
        "module": "esnext",
        "baseUrl": "src/",
        "paths": {
            "@/components/*": ["components/*"],
            "@/constants/*": ["constants/*"],
            "@/contexts/*": ["contexts/*"],
            "@/hooks/*": ["hooks/*"],
            "@/services/*": ["services/*"],
            "@/utility/*": ["utility/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "build/types/**/*.ts",
        "src/vite-env.d.ts",
        "build/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules", "external"]
}
